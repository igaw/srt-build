{% extends 'job-base.jinja2' %}

{% set job_name = 'pi-stress' %}
{#- pi_stress runs its threads at SCHED_FIFO 1-4 and the medium one
    busy-loops; RCU's kthreads (rcuc, rcub, rcu_preempt) default to
    FIFO 1 and starve for the whole run (RCU stall, see
    Documentation/RCU/stallwarn.rst). Put them above pi_stress. #}
{% set kernel_args = ((kernel_args ~ ' ') if kernel_args else '') ~ 'rcutree.kthread_prio=5' %}
{#- Its busy-looping threads leave normal tasks (hackbench, the test
    shell) only what the fair server guarantees them: without it they
    starve, an RCU reader among them stalls RCU and the test shell
    times out (round 9: c2d 583, rpi3-32 604). Keep the fair server. #}
{% set fair_server_off = false %}

{% block tests %}
timeout:
  minutes: 1
definitions:
- repository: {{ test_definitions_url|default('https://github.com/Linaro/test-definitions.git') }}
  from: git
  branch: {{ test_definitions_branch|default('master') }}
  path: automated/linux/pi-stress/pi-stress.yaml
  name: pi-stress
  parameters:
    DURATION: "{{ pi_stress.duration|default('1m') }}"
    BACKGROUND_CMD: "{{ pi_stress.background_cmd|default('hackbench') }}"
    MLOCKALL: "true"
    ARTIFACTORIAL_URL: "{{ artifactorial_url|default('') }}"
    ARTIFACTORIAL_TOKEN: "{{ artifactorial_token|default('') }}"
{% endblock tests -%}
