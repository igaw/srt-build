---
job_name: {{ job_name }}
device_type: {{ device_type }}
timeouts:
  job:
    minutes: {{ 7 if boot_failure_retry else 5 }}
  action:
    minutes: 5
  connection:
    minutes: 5
priority: medium
visibility: public
tags: {{ tags }}
{# What the job is, for `srt-build jobs export` and the dashboards; the
    description (job_name) also has the flavor in it, srt.test doesn't. #}
metadata:
  srt.board: "{{ board }}"
  srt.flavor: "{{ flavor }}"
  srt.test: "{{ job_name.split(' ')[0] }}"
  srt.kernel: "{{ kernel_describe }}"
  srt.build: "{{ srt_build }}"
context:
  extra_kernel_args: systemd.show_status=0 systemd.log_color=0{% if kernel_args %} {{ kernel_args }}{% endif %}

actions:
  - deploy:
      timeout:
        minutes: 5
      to: tftp
      kernel:
        url: {{ kernel_url }}
        type: {{ kernel_type }}
{% if dtb_url %}
      dtb:
        url: {{ dtb_url }}
{% endif %}
      nfsrootfs:
        url: {{ nfsroot_url }}
      os: debian
  
  - boot:
      timeout:
        minutes: 5
{% if boot_failure_retry %}
      failure_retry: {{ boot_failure_retry }}
{% endif %}
      method: {{ boot_method }}
      commands: nfs
      auto_login:
        login_prompt: 'login:'
        username: root
        login_commands:
          - 'export PS1="lava: "'
          - 'export TERM=dumb'
          - 'export NO_COLOR=1'
      prompts:
        - 'lava:'
  
{% if fair_server_off %}
{#- config.yml flavors: fair_server_off. The fair server's runtime per
    CPU, 0 switches it off; the check fails the job if it is still on
    anywhere (or the knob is missing). #}
  - test:
      timeout:
        minutes: 1
      definitions:
      - from: inline
        name: fair-server
        path: inline/fair-server.yaml
        repository:
          metadata:
            format: Lava-Test Test Definition 1.0
            name: fair-server
            description: "switch the fair server off"
          run:
            steps:
            - 'mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug'
            - 'for f in /sys/kernel/debug/sched/fair_server/cpu*/runtime; do echo 0 > "$f"; done'
            - lava-test-case fair-server-off --shell 'ls /sys/kernel/debug/sched/fair_server/cpu*/runtime >/dev/null && ! grep -qv "^0$" /sys/kernel/debug/sched/fair_server/cpu*/runtime'

{% endif %}
  - test:
{{ self.tests() | default('  definitions: []') | indent(6, true) }}

{#- LAVA watches for kernel splats only while booting, not during the test:
    a job whose test passes despite an RCU stall or a WARN still completes.
    Fail it here on anything in the kernel log that looks like a splat.
    "WARNING: CPU:" and not "WARNING:", which also starts plain printks
    (bbb's "WARNING: Your 'console=ttyO0' has been replaced by 'ttyS0'").
    Each splat has such a header line; its call trace is no finding of
    its own, so the known ones (report.KNOWN_KERNEL_WARNINGS) can be left
    out by their header.
    LAVA's shell echoes each step to the console (set -x), where `jobs
    report` scans for kernel problems: Oop[s] and IN[F]O match what Oops
    and INFO would, but the echoed step doesn't look like a finding. #}
  - test:
      timeout:
        minutes: 1
      definitions:
      - from: inline
        name: kernel-log
        path: inline/kernel-log.yaml
        repository:
          metadata:
            format: Lava-Test Test Definition 1.0
            name: kernel-log
            description: "no stalls, warnings or oopses in the kernel log"
          run:
            steps:
            - 'export KLOG_BAD="WARNING: CPU:|BUG:|Oop[s]|rcu: IN[F]O|stall on CPU|blocked for more than"'
            - 'export KLOG_OK="{{ kernel_log_known }}"'
            - lava-test-case kernel-log-clean --shell '! dmesg | grep -E "$KLOG_BAD" | grep -vE "$KLOG_OK"'
