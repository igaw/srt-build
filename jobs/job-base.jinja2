---
job_name: {{ job_name }}
device_type: {{ device_type }}
timeouts:
  job:
    minutes: 5
  action:
    minutes: 5
  connection:
    minutes: 5
priority: medium
visibility: public
tags: {{ tags }}
context:
  extra_kernel_args: systemd.show_status=0 systemd.log_color=0{% if kernel_args %} {{ kernel_args }}{% endif %}

actions:
  - deploy:
      timeout:
        minutes: 5
      to: tftp
      kernel:
        url: {{ kernel_url }}
        type: {{ kernel_type }}
{% if dtb_url %}
      dtb:
        url: {{ dtb_url }}
{% endif %}
      nfsrootfs:
        url: {{ nfsroot_url }}
      os: debian
  
  - boot:
      timeout:
        minutes: 5
      method: {{ boot_method }}
      commands: nfs
      auto_login:
        login_prompt: 'login:'
        username: root
        login_commands:
          - 'export PS1="lava: "'
          - 'export TERM=dumb'
          - 'export NO_COLOR=1'
      prompts:
        - 'lava:'
  
  - test:
{{ self.tests() | default('  definitions: []') | indent(6, true) }}
