{% extends 'job-base.jinja2' %}
{% import 'test-definition.jinja2' as td with context %}

{% set job_name = 'cyclictest rt-isolcpus' %}

{# One thread per isolated CPU; the background load stays on the
   housekeeping CPUs. #}
{% block tests %}
definitions:
{{ td.definition('cyclictest/cyclictest.yaml', 'cyclictest', {
    'AFFINITY': isolcpus,
    'BACKGROUND_CMD': 'taskset -c ' ~ housekeeping_cpus ~ ' ' ~ cyclictest.background_cmd|default('hackbench'),
    'DURATION': cyclictest.duration|default('1m'),
    'HISTOGRAM': cyclictest.histogram|default(''),
    'INTERVAL': cyclictest.interval|default('1000'),
    'RT_PRIORITY': cyclictest.priority|default('98'),
    'THREADS': isolcpus_count,
}) }}
{% endblock tests -%}
