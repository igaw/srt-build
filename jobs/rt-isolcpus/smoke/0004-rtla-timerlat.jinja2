{% extends 'job-base.jinja2' %}

{% set job_name = 'rtla-timerlat rt-isolcpus' %}

{# The isolated CPUs measured; rtla keeps itself on the others #}
{% block tests %}
definitions:
- repository: {{ test_definitions_url|default('https://github.com/Linaro/test-definitions.git') }}
  from: git
  branch: {{ test_definitions_branch|default('master') }}
  path: automated/linux/rtla/rtla-timerlat.yaml
  name: rtla-timerlat
  parameters:
    DURATION: "{{ rtla_timerlat.duration|default('1m') }}"
    PRIORITY: "f:98"
    BACKGROUND_CMD: "taskset -c {{ housekeeping_cpus }} {{ rtla_timerlat.background_cmd|default('hackbench') }}"
    CPUS: "{{ isolcpus }}"
    ARTIFACTORIAL_URL: "{{ artifactorial_url|default('') }}"
    ARTIFACTORIAL_TOKEN: "{{ artifactorial_token|default('') }}"
{% endblock tests -%}
